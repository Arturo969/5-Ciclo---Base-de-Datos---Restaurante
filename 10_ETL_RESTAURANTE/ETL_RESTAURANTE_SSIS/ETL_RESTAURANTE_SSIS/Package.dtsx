                    <outputColumn
                      refId="Package\POBLAR_FAC_VENTAS\Origen de OLE DB.Outputs[Salida de origen de OLE DB].Columns[empleadokey]"
                      dataType="i4"
                      errorOrTruncationOperation="Conversión"

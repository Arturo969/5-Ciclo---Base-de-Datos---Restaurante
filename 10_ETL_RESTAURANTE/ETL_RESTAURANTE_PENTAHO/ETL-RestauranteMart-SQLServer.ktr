    <sql>--## 1. CONSULTA PARA DIM.Cliente

SELECT 
	(Nombres + ' ' +  ApellidoPaterno + ' ' + ApellidoMaterno) AS nombres
FROM CLIENTE.Cliente 
ORDER BY 1;</sql>
